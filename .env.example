# Copy via scripts/bootstrap-dev.sh. Never commit the generated .env.
POSTGRES_SUPER_PASSWORD=replace-me
CORE_DB_PASSWORD=replace-me
AI_DB_PASSWORD=replace-me
KEYCLOAK_ADMIN_PASSWORD=replace-me
KEYCLOAK_DB_PASSWORD=replace-me
KEYCLOAK_WEB_CLIENT_SECRET=dev-only-change-me
MINIO_ROOT_USER=medrag
MINIO_ROOT_PASSWORD=replace-me
AI_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-base64
NEXT_SESSION_KEY_BASE64=replace-with-32-random-bytes-base64
INTERNAL_JWT_KEY_ID=medrag-internal-dev-1

# Optional private/local OpenAI-compatible inference endpoint (vLLM, TGI proxy, etc.)
LLM_BASE_URL=
LLM_API_KEY=local-only
LLM_MODEL=
LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,vllm,tgi,llm

# Optional production tenant-secret resolver. Mount the token file with a deployment override.
VAULT_ADDR=
VAULT_TOKEN_FILE=/vault/secrets/token
VAULT_NAMESPACE=
